PORT=3000
NODE_ENV=development
SEED_DEMO=1
PUBLIC_BASE_URL=http://localhost:3000

# AI
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment / Email
PAYMENT_CHECKOUT_URL=
SMTP_URL=

# PostgreSQL / Supabase
# Vào Supabase Dashboard -> Connect -> Session pooler và dán nguyên connection string.
# Không tự ghép POOLER-HOST. Nếu password có ký tự đặc biệt, dùng đúng chuỗi Supabase cung cấp.
DATABASE_URL=
PGSSL=1
PG_POOL_MAX=5

# Redis
REDIS_URL=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Supabase public browser config
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only secret - NEVER expose in browser/GitHub
SUPABASE_SERVICE_ROLE_KEY=

# Auth / site URLs
APP_PUBLIC_URL=http://localhost:3000
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/#home
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Monitoring
SENTRY_DSN=
MONITORING_WEBHOOK_URL=

# Backup
BACKUP_DIR=./backups
