PORT=3000
NODE_ENV=development
SEED_DEMO=1
PUBLIC_BASE_URL=http://localhost:3000

# AI
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment / Email
PAYMENT_CHECKOUT_URL=
SMTP_URL=

# PostgreSQL / Supabase
# Vào Supabase Dashboard -> Connect -> Session pooler và dán nguyên connection string.
# Không tự ghép POOLER-HOST. Nếu password có ký tự đặc biệt, dùng đúng chuỗi Supabase cung cấp.
DATABASE_URL=
PGSSL=1
PG_POOL_MAX=5

# Redis
REDIS_URL=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
